# Copy to .env.local for development. Never commit real values.
# Variables prefixed NEXT_PUBLIC_ are exposed to the browser; everything else stays on the server.

# --- App -------------------------------------------------------------------
# Public base URL (used in auth emails, Stripe redirects, email links). No trailing slash.
NEXT_PUBLIC_SITE_URL=http://localhost:3000

# --- Supabase (Project Settings → API Keys) --------------------------------
NEXT_PUBLIC_SUPABASE_URL=https://your-project-ref.supabase.co
# Publishable key (sb_publishable_...). The legacy name NEXT_PUBLIC_SUPABASE_ANON_KEY is also accepted.
NEXT_PUBLIC_SUPABASE_PUBLISHABLE_KEY=sb_publishable_xxx
# Secret key (sb_secret_...), SERVER ONLY. The legacy name SUPABASE_SERVICE_ROLE_KEY is also accepted.
SUPABASE_SECRET_KEY=sb_secret_xxx

# --- Payments (Stripe). Leave empty = payments "unconfigured" (bookings can't be paid). ---
STRIPE_SECRET_KEY=
STRIPE_WEBHOOK_SECRET=
# Development only: shows a "Simulate payment" button. Ignored in production builds.
PAYMENTS_DEV_SIMULATION=false

# --- Email -----------------------------------------------------------------
# "console" logs that an email would be sent (dev). "resend" delivers via the Resend HTTP API.
EMAIL_PROVIDER=console
RESEND_API_KEY=
EMAIL_FROM="Docothink <no-reply@your-domain.com>"

# --- Background jobs -------------------------------------------------------
# Long random string. Sent as "Authorization: Bearer <CRON_SECRET>" by pg_cron / Vercel Cron.
CRON_SECRET=

# --- WebRTC ----------------------------------------------------------------
# Comma-separated. STUN alone works for most home networks; TURN is needed for restrictive NATs/firewalls.
WEBRTC_STUN_URLS=stun:stun.l.google.com:19302
WEBRTC_TURN_URLS=
# Preferred: coturn "static-auth-secret" → short-lived per-user credentials are minted server-side.
WEBRTC_TURN_SECRET=
# Alternative: static TURN username/password (less secure; credentials reach the browser).
WEBRTC_TURN_USERNAME=
WEBRTC_TURN_CREDENTIAL=
